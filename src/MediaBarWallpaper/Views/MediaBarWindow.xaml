<Window x:Class="MediaBarWallpaper.Views.MediaBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="360"
        Height="52"
        Focusable="False">
  <Border x:Name="RootBorder"
          CornerRadius="10"
          Background="#E619212E"
          BorderBrush="#2EFFFFFF"
          BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- 封面（SMTC 提供时显示图片，否则音符占位） -->
      <Border Width="38" Height="38" Margin="10,0,10,0" CornerRadius="8" VerticalAlignment="Center" ClipToBounds="True">
        <Grid>
          <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
          <Border x:Name="CoverPlaceholder">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C3AED" Offset="0"/>
                <GradientStop Color="#2563EB" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#x266A;" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <!-- 标题 + 进度条 -->
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TitleText" Text="--" Foreground="#F1F5F9" FontSize="13"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
          <TextBlock x:Name="ArtistText" Text="--" Foreground="#94A3B8" FontSize="11"
                     Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
        </StackPanel>

        <Border x:Name="TrackBorder" Grid.Row="1" Height="3" CornerRadius="1.5"
                Background="#334155" Margin="0,5,10,0">
          <Rectangle x:Name="ProgressFill" Height="3" RadiusX="1.5" RadiusY="1.5"
                     Fill="#818CF8" HorizontalAlignment="Left" Width="0"/>
        </Border>
      </Grid>

      <!-- 控制按钮 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
        <Button x:Name="PrevButton" Style="{StaticResource MediaBarButton}" Content="&#x23EE;" ToolTip="上一首" Click="OnPrevClick"/>
        <Button x:Name="PlayButton" Style="{StaticResource MediaBarButton}" Content="&#x25B6;" ToolTip="播放 / 暂停" Click="OnPlayPauseClick"/>
        <Button x:Name="NextButton" Style="{StaticResource MediaBarButton}" Content="&#x23ED;" ToolTip="下一首" Click="OnNextClick"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
