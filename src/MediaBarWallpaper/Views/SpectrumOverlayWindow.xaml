<Window x:Class="MediaBarWallpaper.Views.SpectrumOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaBarWallpaper.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        IsHitTestVisible="False" Title="SpectrumOverlay">
    <Grid Background="Transparent" IsHitTestVisible="False">
        <local:SpectrumBarsControl x:Name="Bars" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
