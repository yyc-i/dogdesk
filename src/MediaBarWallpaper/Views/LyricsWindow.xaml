<Window x:Class="MediaBarWallpaper.Views.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        IsHitTestVisible="False" Width="800" Height="104" Title="Lyrics">
    <Border Background="#66000000" CornerRadius="12" Padding="16,10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="CurrentLine" Foreground="White" FontSize="22" FontWeight="Bold"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760"/>
            <TextBlock x:Name="NextLine" Foreground="#99FFFFFF" FontSize="14"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
