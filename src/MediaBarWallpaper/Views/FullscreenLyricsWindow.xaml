<Window x:Class="MediaBarWallpaper.Views.FullscreenLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        KeyDown="OnWindowKeyDown"
        MouseDown="OnWindowMouseDown">
  <!-- 背景遮罩（不透明度由 FullscreenLyricsOpacity 控制） -->
  <Border x:Name="MaskBorder" Background="#CC000000">
    <Grid VerticalAlignment="Center">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
        <!-- 当前行（逐字高亮 / 流光 / 浮名） -->
        <TextBlock x:Name="CurrentLine"
                   FontSize="96"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="1600"/>
        <!-- 下一行 -->
        <TextBlock x:Name="NextLine"
                   FontSize="34"
                   Foreground="#99FFFFFF"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="1400"
                   Margin="0,28,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
