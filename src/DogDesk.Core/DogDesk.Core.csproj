<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 跨平台共享核心库：Windows(WPF)/macOS(Avalonia) 共用，不含任何 WPF / Windows 专属依赖 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DogDesk</RootNamespace>
    <AssemblyName>DogDesk.Core</AssemblyName>
    <Version>0.6.0</Version>
    <Description>DogDesk 跨平台共享核心：设置/歌词/频谱/播放队列/在线音源/均衡器/曲库（无 WPF 依赖）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 歌词检索解析（纯托管，跨平台） -->
    <PackageReference Include="Lyricify.Lyrics.Helper" Version="0.2.0" />
    <!-- 仅使用 NAudio.Core（FFT/BiQuad 等纯数学 DSP），不引入 Windows 专属的 Wasapi/WinMM 子包 -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>

</Project>
