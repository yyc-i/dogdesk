<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DogDesk.Mac.Views.MainWindow"
        Width="980" Height="720"
        MinWidth="820" MinHeight="600"
        Title="dogdesk · macOS"
        ExtendClientAreaToDecorationsHint="False">

  <TabControl x:Name="RootTabs" Margin="12">

    <!-- ============ 播放 ============ -->
    <TabItem Header="播放">
      <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="220,*">
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4"
                Background="#222430" CornerRadius="10" Margin="0,0,12,0"
                Width="220" Height="220" VerticalAlignment="Top">
          <Image x:Name="CoverImage" Stretch="UniformToFill"/>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Top">
          <TextBlock x:Name="NowPlayingTitle" FontSize="22" FontWeight="SemiBold" Text="未在播放"/>
          <TextBlock x:Name="NowPlayingArtist" FontSize="14" Opacity="0.7" Text="—"/>
          <TextBlock x:Name="MpvStatus" FontSize="12" Opacity="0.55" Text=""/>
          <TextBlock x:Name="ResumeHint" FontSize="12" Opacity="0.7" Foreground="#8fd0a0" Text=""/>
        </StackPanel>

        <!-- 队列 -->
        <ListBox x:Name="QueueList" Grid.Row="1" Grid.Column="1" Margin="0,10,0,10"
                  SelectionChanged="QueueList_SelectionChanged"/>

        <!-- 控制条 -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
          <Button x:Name="PrevBtn" Content="⏮ 上一首" Click="Prev_Click"/>
          <Button x:Name="PlayBtn" Content="▶ 播放" Click="Play_Click" MinWidth="90"/>
          <Button x:Name="NextBtn" Content="下一首 ⏭" Click="Next_Click"/>
          <Button x:Name="RepeatBtn" Content="循环: 关" Click="Repeat_Click" Margin="10,0,0,0"/>
          <Button x:Name="FavBtn" Content="♡ 收藏" Click="Fav_Click" Margin="10,0,0,0"/>
          <Button x:Name="AddToPlaylistBtn" Content="＋ 加入歌单" Click="AddToPlaylist_Click"/>
        </StackPanel>

        <!-- 进度条放第二行下方，横跨 -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Spacing="2" Margin="0,52,0,0">
          <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1000" Value="0"
                  PointerPressed="Progress_PointerPressed" PointerReleased="Progress_PointerReleased"
                  ValueChanged="Progress_ValueChanged"/>
          <TextBlock x:Name="TimeLabel" FontSize="12" Opacity="0.7" Text="0:00 / 0:00"/>
        </StackPanel>

        <!-- v0.6 音效区：倍速 / 音质 / 3D 环绕 / 预设导入导出 -->
        <Border Grid.Row="3" Grid.Column="1" Background="#1c1e28" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="倍速" VerticalAlignment="Center"/>
              <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2.0" Width="140"
                      ValueChanged="Speed_ValueChanged"/>
              <TextBlock x:Name="SpeedLabel" Width="48" VerticalAlignment="Center" Text="1.0x"/>
              <TextBlock Text="音质" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <ComboBox x:Name="QualityBox" Width="120" SelectionChanged="Quality_SelectionChanged">
                <ComboBoxItem Content="标准"/>
                <ComboBoxItem Content="高"/>
                <ComboBoxItem Content="超高"/>
              </ComboBox>
              <Button Content="导出预设…" Click="PresetExport_Click" Margin="12,0,0,0"/>
              <Button Content="导入预设…" Click="PresetImport_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <ToggleSwitch x:Name="SurroundSwitch" Content="3D 环绕" Click="Surround_Toggled"/>
              <TextBlock Text="宽度" VerticalAlignment="Center"/>
              <Slider x:Name="SurroundWidthSlider" Minimum="0" Maximum="6" Width="120"
                      ValueChanged="SurroundWidth_ValueChanged"/>
              <TextBlock Text="速度" VerticalAlignment="Center"/>
              <Slider x:Name="SurroundSpeedSlider" Minimum="0.1" Maximum="2" Width="120"
                      ValueChanged="SurroundSpeed_ValueChanged"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>

    <!-- ============ 曲库 ============ -->
    <TabItem Header="曲库">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <TextBlock Text="音乐目录:" VerticalAlignment="Center"/>
          <TextBox x:Name="LibraryFolderBox" Width="420" IsReadOnly="True"
                   Watermark="选择本地音乐文件夹"/>
          <Button Content="选择目录…" Click="PickLibrary_Click"/>
          <Button Content="扫描" Click="ScanLibrary_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="LibrarySummary" Opacity="0.7" Margin="0,0,0,6"/>
        <ListBox x:Name="LibraryList" Grid.Row="2" DoubleTapped="LibraryList_DoubleTapped"/>
      </Grid>
    </TabItem>

    <!-- ============ 在线音源 ============ -->
    <TabItem Header="在线音源">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <Border Grid.Row="0" Background="#3a2a1a" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
          <TextBlock x:Name="RiskLabel" Foreground="#ffd28a" TextWrapping="Wrap"
                     Text="第三方非官方接口，仅供学习交流，稳定性与版权不保证，随时可能失效。"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <TextBox x:Name="NeteaseSearchBox" Width="360" Watermark="搜索网易云歌曲…"
                   KeyDown="NeteaseSearch_KeyDown"/>
          <Button Content="搜索" Click="NeteaseSearch_Click"/>
        </StackPanel>

        <!-- v0.6 电台（风格聚合推荐）与排行榜 -->
        <Border Grid.Row="2" Background="#20243a" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
          <StackPanel Spacing="4">
            <TextBlock Text="电台（按风格聚合 60 首）" Opacity="0.8"/>
            <WrapPanel x:Name="RadioPanel"/>
            <TextBlock Text="网易云排行榜" Opacity="0.8" Margin="0,4,0,0"/>
            <WrapPanel x:Name="ChartPanel"/>
          </StackPanel>
        </Border>

        <Expander Grid.Row="3" Header="Navidrome（自建服务器）" IsExpanded="True" Margin="0,0,0,8">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="服务器" VerticalAlignment="Center" Width="50"/>
              <TextBox x:Name="NavServerBox" Width="280" Watermark="https://your.host"/>
              <TextBlock Text="用户名" VerticalAlignment="Center" Width="50"/>
              <TextBox x:Name="NavUserBox" Width="140"/>
              <TextBlock Text="密码" VerticalAlignment="Center" Width="50"/>
              <TextBox x:Name="NavPassBox" Width="140" Watermark="密码"/>
              <Button Content="测试连接" Click="NavTest_Click"/>
              <Button Content="保存并加载专辑" Click="NavLoad_Click"/>
            </StackPanel>
            <TextBlock x:Name="NavStatus" Opacity="0.7"/>
          </StackPanel>
        </Expander>

        <ListBox Grid.Row="4" x:Name="OnlineList" Height="120" Margin="0,0,0,8"
                 DoubleTapped="OnlineList_DoubleTapped"/>
        <ListBox Grid.Row="5" x:Name="NavList" DoubleTapped="NavList_DoubleTapped"/>
      </Grid>
    </TabItem>

    <!-- ============ 均衡器 ============ -->
    <TabItem Header="均衡器">
      <StackPanel Spacing="10" Margin="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ToggleSwitch x:Name="EqEnabledSwitch" Content="启用均衡器" Click="EqEnabled_Toggled"/>
          <Button Content="复位（平直）" Click="EqReset_Click"/>
          <TextBlock x:Name="EqValueLabel" Opacity="0.7" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="10 段图形均衡器（31Hz – 16kHz），增益范围 ±12 dB" Opacity="0.7"/>
        <!-- 10 个 Slider 在代码后置中动态生成到 EqPanel -->
        <StackPanel x:Name="EqPanel" Orientation="Horizontal" Spacing="10"/>
      </StackPanel>
    </TabItem>

    <!-- ============ 歌单（v0.6） ============ -->
    <TabItem Header="歌单">
      <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="220,*">
        <!-- 歌单架：横向封面轮播 -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                      Height="150">
          <WrapPanel x:Name="PlaylistShelfPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- 歌单列表 -->
        <ListBox x:Name="PlaylistList" Grid.Row="1" Grid.Column="0" Margin="0,8,8,0"
                 SelectionChanged="PlaylistList_SelectionChanged"/>

        <!-- 歌单曲目 -->
        <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBlock x:Name="PlaylistNameLabel" Text="选择歌单" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Content="新建歌单…" Click="NewPlaylist_Click"/>
            <Button Content="移除所选" Click="RemovePlaylistItem_Click"/>
          </StackPanel>
          <ListBox x:Name="PlaylistItemsList" Grid.Row="1" DoubleTapped="PlaylistItems_DoubleTapped"/>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ============ AI 伙伴（v0.7） ============ -->
    <TabItem Header="AI 伙伴">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Border Grid.Row="0" Background="#20243a" CornerRadius="8" Padding="10,8">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ToggleSwitch x:Name="AiEnabledSwitch" Content="启用 AI 伙伴" Click="AiEnabled_Toggled"/>
              <TextBlock Text="通道" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <ComboBox x:Name="AiChannelBox" Width="160" SelectionChanged="AiChannel_SelectionChanged">
                <ComboBoxItem Content="本地 Ollama"/>
                <ComboBoxItem Content="云端 OpenAI 兼容"/>
              </ComboBox>
              <TextBlock Text="本地模型" VerticalAlignment="Center"/>
              <ComboBox x:Name="AiLocalModelBox" Width="200" SelectionChanged="AiLocalModel_SelectionChanged"/>
              <Button Content="刷新模型列表" Click="AiRefreshModels_Click"/>
              <TextBlock x:Name="AiStatusLabel" Opacity="0.7" VerticalAlignment="Center" Text="未启用"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="BaseUrl" VerticalAlignment="Center" Width="56"/>
              <TextBox x:Name="AiBaseUrlBox" Width="280" Watermark="https://ark.cn-beijing.volces.com/api/v3"/>
              <TextBlock Text="ApiKey" VerticalAlignment="Center" Width="50"/>
              <TextBox x:Name="AiApiKeyBox" Width="180" Watermark="Bearer Key"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Model" VerticalAlignment="Center" Width="56"/>
              <TextBox x:Name="AiModelBox" Width="220" Watermark="doubao-seed-1.6-lite"/>
              <TextBlock Text="角色" VerticalAlignment="Center" Width="50"/>
              <ComboBox x:Name="AiCharacterBox" Width="140" SelectionChanged="AiCharacter_SelectionChanged"/>
            </StackPanel>
            <TextBox x:Name="AiSystemPromptBox" Watermark="自定义人设（留空则用上方角色预设）"
                     AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <ListBox x:Name="AiChatList" Grid.Row="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="AiInputBox" Watermark="和 AI 伙伴说点什么…（回车发送）"
                   AcceptsReturn="True" Height="40"
                   KeyDown="AiInput_KeyDown"/>
          <Button x:Name="AiSendBtn" Content="发送" Click="AiSend_Click" MinWidth="80"/>
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- ============ 设置 ============ -->
    <TabItem Header="设置">
      <ScrollViewer>
        <StackPanel Spacing="12" Margin="6">
          <!-- v0.7 开机动画 -->
          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="开机动画（v0.7）"/>
              <ToggleSwitch x:Name="BootAnimEnabledSwitch" Content="启用开机动画" Click="BootAnimEnabled_Toggled"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="样式" VerticalAlignment="Center" Width="40"/>
                <ComboBox x:Name="BootAnimStyleBox" Width="160" SelectionChanged="BootAnimStyle_SelectionChanged">
                  <ComboBoxItem Content="Aurora 极光"/>
                  <ComboBoxItem Content="Particle 粒子"/>
                  <ComboBoxItem Content="Pulse 几何脉冲"/>
                  <ComboBoxItem Content="FlowText 流光文字"/>
                  <ComboBoxItem Content="Image 自定义图片"/>
                </ComboBox>
                <TextBlock Text="时长" VerticalAlignment="Center" Width="40"/>
                <Slider x:Name="BootAnimDurationSlider" Minimum="1" Maximum="10" Width="160"
                        ValueChanged="BootAnimDuration_ValueChanged"/>
                <TextBlock x:Name="BootAnimDurationLabel" Width="50" VerticalAlignment="Center" Text="3.5s"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="图片" VerticalAlignment="Center" Width="40"/>
                <TextBox x:Name="BootAnimPathBox" Width="360" Watermark="Image 样式时使用的图片路径"/>
                <Button Content="浏览…" Click="BootAnimBrowse_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ListBox x:Name="BootAnimLibraryList" Width="360" Height="80"/>
                <StackPanel Orientation="Vertical" Spacing="4">
                  <Button Content="预览所选" Click="BootAnimPreview_Click"/>
                  <Button Content="设为当前" Click="BootAnimSetCurrent_Click"/>
                  <Button Content="导入图片…" Click="BootAnimImport_Click"/>
                  <Button Content="删除所选" Click="BootAnimDelete_Click"/>
                </StackPanel>
              </StackPanel>
              <Image x:Name="BootAnimPreviewImage" Height="120" Stretch="Uniform"/>
              <Border Background="#1a1c2a" CornerRadius="6" Padding="8,6">
                <StackPanel Spacing="4">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="AI 生成素材（第三方图像 API，仅供学习）"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="AiGenPromptBox" Width="360" Watermark="例如：梦幻极光，深空紫蓝渐变，极简抽象"/>
                    <Button x:Name="AiGenButton" Content="生成并入库" Click="AiGen_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="AiGenStatusLabel" Opacity="0.7" FontSize="12" Text="需在 AI 伙伴页配置 BaseUrl/Key/Model"/>
                </StackPanel>
              </Border>
              <TextBlock FontSize="12" Opacity="0.6"
                         Text="注：macOS 语音输入（STT）需系统级原生桥接，本版暂不支持，请使用文字输入。"/>
            </StackPanel>
          </Border>

          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="桌面歌词（置顶半透明）"/>
              <ToggleSwitch x:Name="LyricsEnabledSwitch" Content="启用桌面歌词" Click="LyricsEnabled_Toggled"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="透明度" VerticalAlignment="Center" Width="60"/>
                <Slider x:Name="LyricsOpacitySlider" Minimum="0.3" Maximum="1" Width="240"
                        ValueChanged="LyricsOpacity_ValueChanged"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="全屏歌词动画（Folia 风格）"/>
              <ToggleSwitch x:Name="FsLyricsEnabledSwitch" Content="启用全屏歌词" Click="FsLyricsEnabled_Toggled"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="样式" VerticalAlignment="Center" Width="60"/>
                <ComboBox x:Name="FsStyleBox" Width="160" SelectionChanged="FsStyle_SelectionChanged">
                  <ComboBoxItem Content="流光 Flow"/>
                  <ComboBoxItem Content="浮名 Name"/>
                  <ComboBoxItem Content="群唱 Chorus"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="背景遮罩" VerticalAlignment="Center" Width="60"/>
                <Slider x:Name="FsOpacitySlider" Minimum="0.4" Maximum="1" Width="240"
                        ValueChanged="FsOpacity_ValueChanged"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="桌面歌词增强（v0.6）"/>
              <ToggleSwitch x:Name="LyricsDualLineSwitch" Content="双行（显示下一行）" Click="LyricsDualLine_Toggled"/>
              <ToggleSwitch x:Name="LyricsVerticalSwitch" Content="竖排显示" Click="LyricsVertical_Toggled"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="垂直位置" VerticalAlignment="Center" Width="60"/>
                <Slider x:Name="LyricsOffsetSlider" Minimum="0" Maximum="100" Width="240"
                        ValueChanged="LyricsOffset_ValueChanged"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="主面板外观（v0.6）"/>
              <ToggleSwitch x:Name="GlassSwitch" Content="毛玻璃 / 半透明" Click="Glass_Toggled"/>
              <ToggleSwitch x:Name="ResumeSwitch" Content="退出时记忆播放位置" Click="Resume_Toggled"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="面板不透明度" VerticalAlignment="Center" Width="80"/>
                <Slider x:Name="PanelOpacitySlider" Minimum="0.3" Maximum="1" Width="240"
                        ValueChanged="PanelOpacity_ValueChanged"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="外观"/>
              <ToggleSwitch x:Name="DynamicThemeSwitch" Content="封面动态配色" Click="DynamicTheme_Toggled"/>
            </StackPanel>
          </Border>

          <Border Background="#222430" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="运行环境"/>
              <TextBlock x:Name="EnvStatusLabel" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Opacity="0.55" FontSize="12"
                         Text="v0.5 macOS 版不支持桌面壁纸（受 macOS 限制，见 README）。"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</Window>
