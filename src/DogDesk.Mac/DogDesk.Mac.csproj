<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DogDesk.Mac</RootNamespace>
    <AssemblyName>DogDesk.Mac</AssemblyName>
    <Version>0.7.0</Version>
    <Description>DogDesk macOS 版（Avalonia）：播放/曲库/在线音源/均衡器/桌面歌词，v0.5 不支持桌面壁纸</Description>

    <!-- 反射绑定，避免编译绑定在缺 x:DataType 时产生警告，保证 0 警告 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- MainWindow 通过构造函数注入 AppServices，Avalonia 运行时 XAML 加载器用不到无参构造，
         AVLN3001 为误报；显式编译而非运行时加载，故屏蔽该警告 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共享核心库（已冻结，只读引用） -->
    <ProjectReference Include="..\DogDesk.Core\DogDesk.Core.csproj" />
  </ItemGroup>

</Project>
