<Window x:Class="DogDesk.Views.MediaBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="360"
        Height="56"
        Focusable="False">
  <Border x:Name="RootBorder"
          CornerRadius="12"
          Background="#E619212E"
          BorderBrush="#2EFFFFFF"
          BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- 封面（SMTC 提供时显示图片，否则音符占位） -->
      <Border Width="38" Height="38" Margin="10,0,8,0" CornerRadius="9" VerticalAlignment="Center" ClipToBounds="True">
        <Grid>
          <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
          <Border x:Name="CoverPlaceholder">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C3AED" Offset="0"/>
                <GradientStop Color="#2563EB" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#x266A;" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <!-- 标题 + 进度条 + 音量 -->
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TitleText" Text="--" Foreground="#F1F5F9" FontSize="13"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
            <TextBlock x:Name="ArtistText" Text="--" Foreground="#94A3B8" FontSize="11"
                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
          </StackPanel>
          <TextBlock x:Name="VolumeText" Text="" Foreground="#B8C0CC" FontSize="10"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </Grid>

        <!-- 可拖动进度条 -->
        <Border x:Name="TrackBorder" Grid.Row="1" Height="6" CornerRadius="3"
                Background="#33FFFFFF" Margin="0,5,10,0"
                MouseLeftButtonDown="OnTrackMouseDown" MouseMove="OnTrackMouseMove" MouseLeftButtonUp="OnTrackMouseUp">
          <Rectangle x:Name="ProgressFill" RadiusX="3" RadiusY="3"
                     Fill="#818CF8" HorizontalAlignment="Left" Width="0"/>
        </Border>
      </Grid>

      <!-- 控制按钮 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
        <Button x:Name="PrevButton" Style="{StaticResource MediaBarButton}" Content="&#x23EE;" ToolTip="上一首" Click="OnPrevClick"/>
        <Button x:Name="PlayButton" Style="{StaticResource MediaBarButton}" Content="&#x25B6;" ToolTip="播放 / 暂停" Click="OnPlayPauseClick"/>
        <Button x:Name="NextButton" Style="{StaticResource MediaBarButton}" Content="&#x23ED;" ToolTip="下一首" Click="OnNextClick"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
