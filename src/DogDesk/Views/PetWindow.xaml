<Window x:Class="DogDesk.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Topmost="True" Width="320" Height="270">
  <!-- 逻辑画布 360x300 由 Viewbox 等比缩放到窗口尺寸；猫趴在自绘简化 Qwerty 键盘上 -->
  <Viewbox Stretch="Uniform">
    <Canvas x:Name="Root" Width="360" Height="300" Background="Transparent"
            MouseLeftButtonDown="OnDragDown" MouseLeftButtonUp="OnDragUp"
            MouseRightButtonUp="OnRightUp">
    </Canvas>
  </Viewbox>
</Window>
